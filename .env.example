# Copy to .env.local and fill in. Never commit real keys — .env.local is
# gitignored, this file is not.

# Public base URL used for canonical links, OG tags, and the sitemap.
NEXT_PUBLIC_SITE_URL=

# Google Tag Manager container ID (e.g. GTM-XXXXXXX). Omit to skip analytics.
NEXT_PUBLIC_GTM_ID=

# --- Supabase (blog content) -------------------------------------------------
# Project URL from the Supabase dashboard (Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key — safe to expose to the browser; RLS does the guarding.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# --- Review gate feedback delivery (/leave-a-review) -------------------------
# See docs/leave-a-review-setup.md. All four are review-specific on purpose:
# guest complaints must never land in a general new-lead workflow. Until the
# first three are set, submissions are logged server-side and discarded.

# Resend API key (resend.com -> API Keys). Starts with "re_".
RESEND_API_KEY=
# Sender address. MUST be on a domain verified in Resend, or sends fail.
RESEND_FROM=
# Internal recipient for guest feedback — the inbox that actually follows up.
REVIEW_FEEDBACK_TO=
# Optional: POST each submission as JSON to a CRM/automation endpoint too.
REVIEW_FEEDBACK_WEBHOOK_URL=
